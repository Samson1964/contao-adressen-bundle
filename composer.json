{
    "name": "schachbulle/contao-adressen-bundle",
    "type": "contao-bundle",
    "description": "Adressen-Verwaltung für Contao 4.13 und Contao 5",
    "keywords": [
        "contao",
        "adressen",
        "kontakte"
    ],
    "homepage": "https://github.com/Samson1964/contao-adressen-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Binding",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoAdressenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoAdressenBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoAdressenBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-adressen-bundle/issues",
        "source": "https://github.com/Samson1964/contao-adressen-bundle"
    }
}

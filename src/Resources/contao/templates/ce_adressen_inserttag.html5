<span class="ce_adresse">

	<?php if($this->id && $this->aktiv): ?>

		<?php if($this->bildurl && $this->thumburl): ?>
			<figure class="image_container float_left">
				<a href="<?= $this->bildurl ?>" data-lightbox="adresse<?= $this->id ?>"><img src="<?= $this->thumburl ?>" alt="Bild von <?= $this->name ?>" title="Bild von <?= $this->name ?>"></a>
			</figure>
		<?php endif; ?>

		<?php if($this->funktion): ?>
			<span class="adr_funktion"><?= $this->funktion ?>:</span>
		<?php endif; ?>

		<?php if($this->funktioninfo): ?>
			<span class="adr_funktioninfo"><?= $this->funktioninfo ?></span>
		<?php endif; ?>

		<?php if($this->name): ?>
			<?php if($this->visitenkarte): ?>
				<span class="adr_name adr_info" onmouseover="return overlib('<?= $this->visitenkarte ?>',CAPTION,'Informationen zu <?= $this->name ?>',BGCOLOR,'#00006C',FGCLASS,'funktionsbox',WIDTH,'450');" onmouseout="return nd();">
			<?php else: ?>
				<span class="adr_name">
			<?php endif; ?>
			<?= $this->name ?></span><br />
		<?php endif; ?>

		<?php if($this->adresse): ?>
			<span class="adr_adresse"><?= $this->adresse ?></span><br />
		<?php endif; ?>

		<?php if($this->telefon): ?>
			<span class="telefon"><?= $this->telefon ?></span><br />
		<?php endif; ?>

		<?php if($this->handy): ?>
			<span class="handy"><?= $this->handy ?></span><br />
		<?php endif; ?>

		<?php if($this->telefax): ?>
			<span class="fax"><?= $this->telefax ?></span><br />
		<?php endif; ?>

		<?php if($this->email): ?>
			<span class="adr_email"><?= $this->email ?></span><br />
		<?php endif; ?>

		<?php if($this->homepage): ?>
			<a class="homepage" title="Homepage" href="<?= $this->homepage ?>" target="_blank" rel="noopener"><?= $this->homepage ?></a>
		<?php endif; ?>

		<?php if($this->facebook): ?>
			<a class="facebook" title="Facebook" href="https://www.facebook.com/<?= $this->facebook ?>" target="_blank" rel="noopener"><?= $this->facebook ?></a>
		<?php endif; ?>

		<?php if($this->twitter): ?>
			<a class="twitter" title="Twitter" href="https://twitter.com/<?= $this->twitter ?>" target="_blank" rel="noopener"><?= $this->twitter ?></a>
		<?php endif; ?>

		<?php if($this->instagram): ?>
			<a class="instagram" title="Instagram" href="https://www.instagram.com/<?= $this->instagram ?>/" target="_blank" rel="noopener"><?= $this->instagram ?></a>
		<?php endif; ?>

	<?php else: ?>

		<?php if($this->funktion): ?>
			<span class="adr_funktion"><?= $this->funktion ?>:</span>
		<?php endif; ?>

		<span class="adr_inaktiv">z.Z. unbesetzt</span>

	<?php endif; ?>

</span>

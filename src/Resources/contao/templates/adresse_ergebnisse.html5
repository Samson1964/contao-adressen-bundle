<?php $GLOBALS['TL_JAVASCRIPT']['adressen'] = 'bundles/contaoadressen/js/adressen.js|static'; ?>
<?php $L = $GLOBALS['TL_LANG']['MSC']['adressen_suche'] ?? array(); ?>

<div class="<?= $this->class ?> block"<?= $this->cssID ?><?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>

	<div class="suchformular">
		<form action="" method="get">
			<label for="adr_suche"><?= $L['suchbegriff'] ?? 'Suchbegriff:' ?></label> <input type="text" id="adr_suche" name="s" class="text" value="<?= \Contao\StringUtil::specialchars($this->Suchbegriff) ?>">
			<fieldset>
				<legend><?= $L['mitglied_in'] ?? 'Mitglied in' ?></legend>
				<ul>
				<?php foreach($this->Funktionen as $key => $value): ?>
					<li><label><input type="checkbox" name="funktion[]" value="<?= $key ?>"<?php if(in_array($key, $this->Funktionsauswahl)): ?> checked<?php endif; ?>> <?= \Contao\StringUtil::specialchars($value) ?></label></li>
				<?php endforeach; ?>
				</ul>
				<div style="clear:both; padding-top:5px;"><?= $L['verknuepfung'] ?? 'Verknüpfung:' ?>
					<label><input type="radio" name="join" value="and"<?php if($this->Verknuepfung == 'AND'): ?> checked<?php endif; ?>> <?= $L['und'] ?? 'UND' ?></label>
					<label><input type="radio" name="join" value="or"<?php if($this->Verknuepfung == 'OR'): ?> checked<?php endif; ?>> <?= $L['oder'] ?? 'ODER' ?></label>
				</div>
			</fieldset>
			<fieldset>
				<legend><?= $L['nur_emails'] ?? 'Nur E-Mails anzeigen' ?></legend>
				<ul>
					<li><label><input type="checkbox" name="email" value="1"<?php if($this->Liteversion): ?> checked<?php endif; ?>> <?= $L['eingeschaltet'] ?? 'Eingeschaltet' ?></label></li>
				</ul>
			</fieldset>
			<input type="submit" class="submit" value="<?= \Contao\StringUtil::specialchars($L['suchen'] ?? 'Suchen') ?>">
		</form>
	</div>
	<div style="clear:both"></div>

	<?php if ($this->Gesucht): ?>
		<?php if ($this->Ergebnisliste): ?>
			<div class="trefferliste">
				<p><?= sprintf($L['treffer'] ?? 'Du suchtest nach "<i>%s</i>". Wir haben %d Datensätze in unserer Datenbank.', \Contao\StringUtil::specialchars($this->Suchbegriff), count($this->Ergebnisliste)) ?></p>
				<?php if($this->Liteversion): ?>
					<?php foreach($this->Ergebnisliste as $item): ?>
						<?php $checked = false; ?>
						<?php for($i = 1; $i <= 6; $i++): ?>
							<?php if($item['email'.$i]): ?>
								<?php $adresse = trim($item['vorname'].' '.$item['nachname']).' <'.$item['email'.$i].'>'; ?>
								<input type="checkbox" class="email-auswahl" name="email_aktiv[]" value="<?= \Contao\StringUtil::specialchars($adresse) ?>"<?php if(!$checked): ?> checked<?php $checked = true; ?><?php endif; ?>>
								<?= \Contao\StringUtil::specialchars($adresse) ?><br>
							<?php endif; ?>
						<?php endfor; ?>
					<?php endforeach; ?>
					<textarea id="kopiertext" style="display:none;"></textarea>
					<button type="button" id="kopieren"><?= $L['kopieren'] ?? 'Ausgewählte Adressen kopieren' ?></button>
				<?php else: ?>
					<ul>
					<?php foreach($this->Ergebnisliste as $item): ?>
						<li class="<?= $item['deaktiviert'] ?><?= $item['unverlinkt'] ?>">
						<?php if($item['firma']): ?>
							<div class="firma"><?= \Contao\StringUtil::specialchars($item['firma']) ?></div>
						<?php endif; ?>
						<?php if($item['vorname'] || $item['nachname']): ?>
							<div class="name"><?= \Contao\StringUtil::specialchars(trim($item['vorname'].' '.$item['nachname'])) ?></div>
						<?php endif; ?>
						<?php if($item['plz'] || $item['ort'] || $item['strasse']): ?>
							<div class="adresse"><?= \Contao\StringUtil::specialchars(trim($item['plz'].' '.$item['ort'])) ?><?php if($item['strasse']): ?>, <?= \Contao\StringUtil::specialchars($item['strasse']) ?><?php endif; ?></div>
						<?php endif; ?>
						<?php if($item['homepage']): ?>
							<div class="homepage"><a href="<?= \Contao\StringUtil::specialchars($item['homepage']) ?>" target="_blank" rel="noopener" class="homepage"><?= \Contao\StringUtil::specialchars($item['homepage']) ?></a></div>
						<?php endif; ?>
						<?php if($item['telefon']): ?>
							<div class="telefon">
								<?php for($i = 1; $i <= 4; $i++): ?>
									<?php if($item['telefon'.$i]): ?>&nbsp;<a href="tel:<?= \Contao\StringUtil::specialchars($item['telefon'.$i.'sel']) ?>"><?= \Contao\StringUtil::specialchars($item['telefon'.$i]) ?></a><?php endif; ?>
								<?php endfor; ?>
							</div>
						<?php endif; ?>
						<?php if($item['email']): ?>
							<div class="email">
								<?php for($i = 1; $i <= 6; $i++): ?>
									<?php if($item['email'.$i]): ?>&nbsp;{{email::<?= $item['email'.$i] ?>}}<?php endif; ?>
								<?php endfor; ?>
							</div>
						<?php endif; ?>
						</li>
					<?php endforeach; ?>
					</ul>
				<?php endif; ?>
			</div>
		<?php else: ?>
			<div class="trefferliste">
				<p><?= sprintf($L['kein_treffer'] ?? 'Du suchtest nach "<i>%s</i>". Wir haben leider keine Adresse gefunden.', \Contao\StringUtil::specialchars($this->Suchbegriff)) ?></p>
			</div>
		<?php endif; ?>
	<?php endif; ?>

	<div class="hinweis">
		<?= $L['hinweis'] ?? '' ?>
	</div>

</div>
